{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "envdiff-worker",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "envdiff.dev", "custom_domain": true },
    { "pattern": "www.envdiff.dev", "custom_domain": true }
  ]
}
